{
  "agent_id": "evidra-dogfood-001",
  "domain": "code",
  "sources": [
    {
      "adapter": "local_files",
      "config": { "path": ".", "glob": ["docs/**/*.md", "src/**/*.py"], "watch": false }
    }
  ],
  "quality": {
    "min_confidence": 0.0,
    "min_extraction_method": "ml_python"
  },
  "staleness": {
    "stale_after_days": 30,
    "invalidate_after_days": 90
  },
  "monitoring": {
    "watch_cycles": false,
    "watch_gaps_in_chains": [],
    "alert_on_new_relation_involving": []
  },
  "actions": {
    "allowed": ["ingest", "validate", "report"],
    "forbidden": ["modify_existing_relation", "delete_node"]
  },
  "output": {
    "default_format": "json"
  }
}

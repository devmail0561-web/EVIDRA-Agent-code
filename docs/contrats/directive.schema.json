{
  "$defs": {
    "Actions": {
      "additionalProperties": false,
      "description": "Actions autorisées/interdites à l'agent.",
      "properties": {
        "allowed": {
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "forbidden": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden",
          "type": "array"
        }
      },
      "title": "Actions",
      "type": "object"
    },
    "AgentPair": {
      "additionalProperties": false,
      "description": "Agent pair autorisé (autorité d'écriture, §8.5).",
      "properties": {
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "max_confidence_accepted": {
          "default": 1.0,
          "description": "plafond accepté (neutre 1.0 = aucun, T9.3)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Confidence Accepted",
          "type": "number"
        },
        "cle_id": {
          "default": "",
          "description": "clé HMAC (api.cles_directive), vide = rejet (T9.3)",
          "title": "Cle Id",
          "type": "string"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "AgentPair",
      "type": "object"
    },
    "ApiConfig": {
      "additionalProperties": false,
      "description": "Exposition HTTP (T8.3) : vide = ouvert dev/dogfood (documenté).",
      "properties": {
        "jetons": {
          "items": {
            "$ref": "#/$defs/JetonApi"
          },
          "title": "Jetons",
          "type": "array"
        },
        "cles_directive": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "clé_id → secret HMAC (fichier 0600, jamais repo, T8.3)",
          "title": "Cles Directive",
          "type": "object"
        },
        "timeout_s": {
          "default": 5.0,
          "description": "[provisoire] attente réponse scheduler (T8.1)",
          "exclusiveMinimum": 0.0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "title": "ApiConfig",
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "description": "Budgets par cycle (scheduler T1.5, directive T4.4).",
      "properties": {
        "max_tool_calls": {
          "default": 6,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_ingest_per_cycle": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Ingest Per Cycle"
        },
        "max_cycle_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cycle Ms"
        },
        "max_wal_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wal Bytes"
        },
        "reserve_fond": {
          "default": 1,
          "minimum": 0,
          "title": "Reserve Fond",
          "type": "integer"
        },
        "timeout_travailleur_s": {
          "default": 30.0,
          "description": "[provisoire] timeout workers extract/reason/Rust (T1.5)",
          "exclusiveMinimum": 0.0,
          "title": "Timeout Travailleur S",
          "type": "number"
        },
        "timeout_http_s": {
          "default": 5.0,
          "description": "[provisoire] timeout requêtes HTTP flux (T9.8)",
          "exclusiveMinimum": 0.0,
          "title": "Timeout Http S",
          "type": "number"
        },
        "backoff_plafond_s": {
          "default": 300.0,
          "description": "[provisoire] plafond du backoff flux (T9.8)",
          "exclusiveMinimum": 0.0,
          "title": "Backoff Plafond S",
          "type": "number"
        },
        "attente_boucle_s": {
          "default": 0.05,
          "description": "[provisoire] attente entre ticks à vide (T4.4)",
          "exclusiveMinimum": 0.0,
          "title": "Attente Boucle S",
          "type": "number"
        },
        "fsync_batch_lignes": {
          "default": 100,
          "description": "[provisoire] fsync WAL toutes les N lignes (T2.1)",
          "minimum": 1,
          "title": "Fsync Batch Lignes",
          "type": "integer"
        },
        "fsync_batch_ms": {
          "default": 1000.0,
          "description": "[provisoire] fsync WAL au plus tous les N ms (T2.1)",
          "exclusiveMinimum": 0.0,
          "title": "Fsync Batch Ms",
          "type": "number"
        },
        "cache_taille_max": {
          "default": 1024,
          "description": "[provisoire] entrées max du cache requêtes LRU (T5.6)",
          "minimum": 1,
          "title": "Cache Taille Max",
          "type": "integer"
        }
      },
      "title": "Budgets",
      "type": "object"
    },
    "JetonApi": {
      "additionalProperties": false,
      "description": "Jeton porteur : empreinte SHA-256 (jamais le secret), verbes liés (T8.3).",
      "properties": {
        "nom": {
          "minLength": 1,
          "title": "Nom",
          "type": "string"
        },
        "empreinte": {
          "description": "hex SHA-256 du jeton",
          "minLength": 16,
          "title": "Empreinte",
          "type": "string"
        },
        "verbes": {
          "items": {
            "$ref": "#/$defs/Verb"
          },
          "title": "Verbes",
          "type": "array"
        }
      },
      "required": [
        "nom",
        "empreinte"
      ],
      "title": "JetonApi",
      "type": "object"
    },
    "PermissionDirective": {
      "additionalProperties": false,
      "description": "Une règle : outil (`*` = tous), verbe, périmètre (`*` = tous).",
      "properties": {
        "tool": {
          "default": "*",
          "title": "Tool",
          "type": "string"
        },
        "verb": {
          "$ref": "#/$defs/Verb"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "scope"
      ],
      "title": "PermissionDirective",
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "Matrice `allowed`/`forbidden` (porte `can()`, T1.4).",
      "properties": {
        "allowed": {
          "items": {
            "$ref": "#/$defs/PermissionDirective"
          },
          "title": "Allowed",
          "type": "array"
        },
        "forbidden": {
          "items": {
            "$ref": "#/$defs/PermissionDirective"
          },
          "title": "Forbidden",
          "type": "array"
        }
      },
      "title": "Permissions",
      "type": "object"
    },
    "Provisoire": {
      "additionalProperties": false,
      "description": "Constantes d'arbitrage — TOUTES `[provisoire]` (I9), calibration T10.3.",
      "properties": {
        "t_domaine": {
          "default": 30.0,
          "description": "[provisoire] constante de temps (jours, demi-vie = T·ln2)",
          "exclusiveMinimum": 0.0,
          "title": "T Domaine",
          "type": "number"
        },
        "nmax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "default": 50,
          "description": "[provisoire] saturation Nmax (norm_conf)",
          "title": "Nmax"
        },
        "seuil_quorum": {
          "default": 2.0,
          "description": "[provisoire] ratio > seuil ⇒ l'arête l'emporte",
          "exclusiveMinimum": 1.0,
          "title": "Seuil Quorum",
          "type": "number"
        },
        "seuil_revision": {
          "default": 3.0,
          "description": "[provisoire] ratio ≤ seuil ⇒ EN RÉVISION (amendement)",
          "exclusiveMinimum": 1.0,
          "title": "Seuil Revision",
          "type": "number"
        },
        "n_confirmation": {
          "default": 3,
          "description": "[provisoire] confirmations ⇒ CONFIRMÉE (T6.1)",
          "minimum": 2,
          "title": "N Confirmation",
          "type": "integer"
        },
        "poids_confirmation": {
          "default": 0.7,
          "description": "[provisoire] fiabilité source (T6.3)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Poids Confirmation",
          "type": "number"
        },
        "n_min_source": {
          "default": 5,
          "description": "[provisoire] plancher effectif fiabilité (T6.3)",
          "minimum": 1,
          "title": "N Min Source",
          "type": "integer"
        },
        "seuil_confiance_source": {
          "default": 0.8,
          "description": "[provisoire] trusted si ≥ et contradiction ≤ plafond",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Seuil Confiance Source",
          "type": "number"
        },
        "plafond_contradiction": {
          "default": 0.05,
          "description": "[provisoire] trusted si contradiction ≤ (T6.3)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Plafond Contradiction",
          "type": "number"
        },
        "seuil_suspect": {
          "default": 0.1,
          "description": "[provisoire] contradiction > ⇒ suspect (T6.3)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Seuil Suspect",
          "type": "number"
        },
        "plancher_surveillee": {
          "default": 0.6,
          "description": "[provisoire] monitored dès (T6.3)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Plancher Surveillee",
          "type": "number"
        }
      },
      "title": "Provisoire",
      "type": "object"
    },
    "Qualite": {
      "additionalProperties": false,
      "description": "Seuils d'admission (ingest T3.6 ; mapping méthode en T4.1+).",
      "properties": {
        "min_confidence": {
          "default": 0.7,
          "description": "seuil d'admission (étude §7 : 0.70)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Confidence",
          "type": "number"
        },
        "min_extraction_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "symbolic_rust",
          "description": "méthode exigée (vocabulaire moteur constaté)",
          "title": "Min Extraction Method"
        },
        "seuils_tiers": {
          "default": [
            0.85,
            0.65
          ],
          "description": "[provisoire] tiers confiance index (high, medium), étude §7.2",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Seuils Tiers",
          "type": "array"
        },
        "limite_repli_lexical": {
          "default": 50,
          "description": "[provisoire] borne du repli sous-chaîne (T2.5)",
          "minimum": 1,
          "title": "Limite Repli Lexical",
          "type": "integer"
        }
      },
      "title": "Qualite",
      "type": "object"
    },
    "Sortie": {
      "additionalProperties": false,
      "description": "Formats et destinations (egress réseau = verbe contrôlé, T9.9).",
      "properties": {
        "default_format": {
          "default": "json",
          "title": "Default Format",
          "type": "string"
        },
        "alert_endpoint": {
          "default": "",
          "title": "Alert Endpoint",
          "type": "string"
        },
        "report_schedule": {
          "default": "",
          "title": "Report Schedule",
          "type": "string"
        },
        "egress_hotes": {
          "description": "T9.9 : hôtes autorisés en sortie (vide = aucun egress, fail-closed)",
          "items": {
            "type": "string"
          },
          "title": "Egress Hotes",
          "type": "array"
        },
        "limite_section": {
          "default": 100,
          "description": "[provisoire] faits par section de rapport (T5.8)",
          "minimum": 1,
          "title": "Limite Section",
          "type": "integer"
        }
      },
      "title": "Sortie",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Source externe : adaptateur interchangeable + config (non hardcodée).",
      "properties": {
        "adapter": {
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "adapter"
      ],
      "title": "Source",
      "type": "object"
    },
    "Staleness": {
      "additionalProperties": false,
      "description": "Rythme de vieillissement du domaine (jours).",
      "properties": {
        "stale_after_days": {
          "default": 30.0,
          "description": "[provisoire] STALE après N jours (étude : CTI 30 j)",
          "exclusiveMinimum": 0.0,
          "title": "Stale After Days",
          "type": "number"
        },
        "invalidate_after_days": {
          "default": 90.0,
          "description": "[provisoire] INVALIDÉE après N jours sans re-confirm.",
          "exclusiveMinimum": 0.0,
          "title": "Invalidate After Days",
          "type": "number"
        },
        "retention_jours": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "T9.10 : purge des preuves après délai (None = conserver)",
          "title": "Retention Jours"
        }
      },
      "title": "Staleness",
      "type": "object"
    },
    "Surveillance": {
      "additionalProperties": false,
      "description": "Conditions du moniteur (phase 7 ; regex validées anti-ReDoS).",
      "properties": {
        "watch_cycles": {
          "default": false,
          "title": "Watch Cycles",
          "type": "boolean"
        },
        "watch_gaps_in_chains": {
          "description": "chaînes surveillées (nœuds, T7.3)",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Watch Gaps In Chains",
          "type": "array"
        },
        "alert_on_new_relation_involving": {
          "items": {
            "type": "string"
          },
          "title": "Alert On New Relation Involving",
          "type": "array"
        },
        "dedup_fenetre_s": {
          "default": 3600,
          "description": "[provisoire] non réémission d'une alerte (T7.2)",
          "minimum": 0,
          "title": "Dedup Fenetre S",
          "type": "integer"
        },
        "alert_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "egress optionnel des alertes (T7.2, hors ligne ⇒ dégradé)",
          "title": "Alert Endpoint"
        },
        "seuil_invalidation": {
          "default": 0.8,
          "description": "[provisoire] haute confiance invalidée ⇒ critique (T7.1)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Seuil Invalidation",
          "type": "number"
        },
        "timeout_egress_s": {
          "default": 5.0,
          "description": "[provisoire] timeout envoi alertes (T7.2, best-effort)",
          "exclusiveMinimum": 0.0,
          "title": "Timeout Egress S",
          "type": "number"
        },
        "alertes_rapport_max": {
          "default": 5,
          "description": "[provisoire] alertes retenues par reçu de boucle (T4.4)",
          "minimum": 1,
          "title": "Alertes Rapport Max",
          "type": "integer"
        },
        "profondeur_gaps": {
          "default": 1,
          "description": "[provisoire] profondeur BFS des lacunes (T7.3)",
          "minimum": 1,
          "title": "Profondeur Gaps",
          "type": "integer"
        }
      },
      "title": "Surveillance",
      "type": "object"
    },
    "Verb": {
      "enum": [
        "read",
        "ingest",
        "modify",
        "delete",
        "alert",
        "egress"
      ],
      "title": "Verb",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Directive : mission complète d'un agent sur un domaine (§9.3).",
  "properties": {
    "agent_id": {
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "domain": {
      "minLength": 1,
      "title": "Domain",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/Qualite"
    },
    "staleness": {
      "$ref": "#/$defs/Staleness"
    },
    "monitoring": {
      "$ref": "#/$defs/Surveillance"
    },
    "actions": {
      "$ref": "#/$defs/Actions"
    },
    "output": {
      "$ref": "#/$defs/Sortie"
    },
    "budgets": {
      "$ref": "#/$defs/Budgets"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "channel_ceilings": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "[provisoire] plafonds par canal, confiances non calibrées (B1)",
      "title": "Channel Ceilings",
      "type": "object"
    },
    "aliases": {
      "additionalProperties": {
        "additionalProperties": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": "object"
      },
      "description": "table d'alias par domaine (promotion humaine, §19)",
      "title": "Aliases",
      "type": "object"
    },
    "seuils_provisoires": {
      "$ref": "#/$defs/Provisoire"
    },
    "delegate": {
      "const": "disabled",
      "default": "disabled",
      "description": "gate P3 : toute autre valeur refusée avant T10.7",
      "title": "Delegate",
      "type": "string"
    },
    "deduction": {
      "default": "disabled",
      "description": "gate T6.6 : déduction tracée interdite par défaut",
      "enum": [
        "disabled",
        "enabled"
      ],
      "title": "Deduction",
      "type": "string"
    },
    "semantic_index_min_edges": {
      "default": 500000,
      "exclusiveMinimum": 0,
      "title": "Semantic Index Min Edges",
      "type": "integer"
    },
    "trusted_agents": {
      "items": {
        "$ref": "#/$defs/AgentPair"
      },
      "title": "Trusted Agents",
      "type": "array"
    },
    "api": {
      "$ref": "#/$defs/ApiConfig"
    }
  },
  "required": [
    "agent_id",
    "domain"
  ],
  "title": "Directive",
  "type": "object"
}
